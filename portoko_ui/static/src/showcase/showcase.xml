<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="portoko_ui.Showcase">
        <div class="o_action ptk ptk-showcase h-100 overflow-auto" t-att-data-ptk-module="state.module" style="background:var(--ptk-paper)">
            <div class="container-fluid py-3" style="max-width:1200px">
                <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Module">
                    <t t-foreach="modules" t-as="m" t-key="m.id">
                        <button type="button" class="ptk-pill" t-att-aria-pressed="state.module === m.id ? 'true' : 'false'" t-on-click="() => this.pick(m.id)">
                            <PtkEmblem module="m.id" size="24"/>
                            <span t-esc="m.title"/>
                        </button>
                    </t>
                </div>

                <PtkModuleHeader module="state.module" title="current.title" subtitle="current.sub"/>

                <div class="row g-3 mt-1">
                    <div class="col-12 col-lg-6 d-flex flex-column gap-3">
                        <div t-ref="scan" class="rounded-4">
                            <PtkScanFeedback state="state.scan" title="scanTitle" text="'Map plastik F4 biru'" qty="state.qty + '/20'"/>
                        </div>
                        <div class="d-grid gap-2" style="grid-template-columns:1fr 1fr 1fr">
                            <button type="button" class="ptk-btn" t-on-click="() => this.scan('ok')">Scan OK</button>
                            <button type="button" class="ptk-btn ptk-btn-secondary" t-on-click="() => this.scan('warn')">Lebih</button>
                            <button type="button" class="ptk-btn ptk-btn-secondary" t-on-click="() => this.scan('stop')">Salah</button>
                        </div>
                        <button type="button" class="ptk-btn ptk-btn-module ptk-btn-xl ptk-btn-block" t-on-click="() => this.scan('ok')">SCAN <span class="ptk-key">F2</span></button>
                        <div class="d-flex flex-wrap gap-2">
                            <PtkStatusChip state="'ok'" label="'Aman'"/>
                            <PtkStatusChip state="'warn'" label="'Reorder'"/>
                            <PtkStatusChip state="'stop'" label="'Salah barang'"/>
                            <PtkStatusChip state="'none'" label="'Draft'"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 d-flex flex-column gap-3">
                        <div class="row g-3">
                            <div class="col-6"><PtkKpi label="'SKU perlu reorder'" value="'37'" note="'12 di bawah safety stock'" tone="'warn'"/></div>
                            <div class="col-6"><PtkKpi label="'Error forecast'" value="'14,8%'" note="'turun 3,1 poin'" tone="'ok'"/></div>
                        </div>
                        <PtkEmptyState module="state.module" title="'4 SKU baru belum bisa diprediksi'" text="'Butuh minimal 6 minggu data penjualan.'">
                            <button type="button" class="ptk-btn ptk-btn-secondary mt-1">Atur stok minimum</button>
                        </PtkEmptyState>
                    </div>
                </div>

                <h2 class="ptk-display mt-4 mb-3" style="font-size:22px">Ornamen</h2>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="rounded-4 position-relative overflow-hidden" style="background:#0a0a0a;height:180px">
                            <PtkOrnament name="'sd'" ln="'#c9a44c'" dt="'#c9a44c'" fl="'#0b3d25'" style="'position:absolute;left:0;top:0;width:150px;height:150px'"/>
                            <PtkOrnament name="'aw'" ln="'#c9a44c'" bg="'#0a0a0a'" fl="'#0a0a0a'" style="'position:absolute;right:24px;top:30px;width:200px;height:100px'"/>
                            <PtkOrnament name="'pg'" ln="'#c9a44c'" dt="'#c9a44c'" fl="'#0b3d25'" style="'position:absolute;left:0;bottom:0;width:100%;height:20px'"/>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="rounded-4 d-flex align-items-center justify-content-around flex-wrap gap-3 p-3" style="background:#f7f3e8;min-height:180px">
                            <PtkEmblem module="'barcode'" size="64"/>
                            <PtkEmblem module="'pos'" size="64"/>
                            <PtkEmblem module="'forecast'" size="64"/>
                            <PtkEmblem module="'bi'" size="64"/>
                            <PtkOrnament name="'dv'" ln="'#111111'" dt="'#0b6b3f'" fl="'#d9ff5c'" style="'width:240px;height:15px'"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
